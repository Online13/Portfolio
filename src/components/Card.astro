---
import type { HTMLAttributes, HTMLTag } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  as?: HTMLTag;
}

const { class: className, as: Tag = "div", ...props } = Astro.props;
---

<Tag
  {...props}
  class:list={[
    className,
    "border border-gray-200 p-4 cursor-pointer hover:bg-stone-100/70 transition-colors duration-500 rounded-md",
  ]}
>
  <slot />
</Tag>
