---
import SocialNetworkLinks from "./SocialNetworkLinks.astro";

const startMonth = 11;
const startYear = 2021;

const now = new Date();
const currentMonth = now.getMonth() + 1;
const currentYear = now.getFullYear();

const experienceYears =
  currentYear - startYear + (currentMonth >= startMonth ? 0 : -1);
---

<div class="space-y-4">
  <div class="max-w-130 w-full text-gray-500 text-base">
    <span class="max-w-140">
      <b>Hi</b>, I'm
      <img
        src="https://rayane-nekena.is-a.dev/assets/profile-8952f84b.webp"
        alt="profile picture"
        class="inline shrink-0 w-6 h-6 bg-center bg-cover"
      />
      <b>Rayane,</b> a <b> Software Engineer </b>
      and <b>React Native enthusiast</b>, with over <b
        >{experienceYears} years</b
      > of experience
      <b class="underline">
        building scalable applications, contributing to super apps, and
        delivering high-impact products</b
      >.
    </span>
  </div>
  <div class="max-w-130 w-full text-gray-500">
    <span class="max-w-140">
      My engineering <b>mindset</b> was shaped in the <b>MISA</b> environment.
    </span>
  </div>
  <div class="max-w-130 w-full text-gray-500">
    <span class="max-w-140">
      I enjoy designing <b>clean architectures</b> and building
      <b>high-performance user interfaces</b> supported by
      <b>reliable backend systems</b>. In my work, I place strong emphasis on
      <b>code quality</b>,
      <b>thoughtful system design</b>, and creating a
      <b>developer experience</b> that helps teams build and maintain software efficiently.
    </span>
  </div>
  <div class="grid gap-2">
    <p class="text-gray-500">Find me on :</p>
    <SocialNetworkLinks />
  </div>
</div>
