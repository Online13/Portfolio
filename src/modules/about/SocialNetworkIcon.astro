---
import type { IconType } from "../../type";
import EmailIcon from "./icons/EmailIcon.astro";
import FacebookIcon from "./icons/FacebookIcon.astro";
import GithubIcon from "./icons/GithubIcon.astro";
import LinkedinIcon from "./icons/LinkedinIcon.astro";
import WhatsappIcon from "./icons/WhatsappIcon.astro";

interface Props {
  type: IconType;
}

const { type } = Astro.props;
---

{type === "github" && <GithubIcon />}
{type === "linkedin" && <LinkedinIcon />}
{type === "whatsapp" && <WhatsappIcon />}
{type === "facebook" && <FacebookIcon />}
{type === "email" && <EmailIcon />}
