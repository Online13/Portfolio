<footer
	id="site-footer"
	class="w-full h-[50vh] fixed bottom-0 left-0 z-10 flex justify-center py-8 bg-black text-white"
>
	<div class="w-full max-w-160 px-4">
		<p class="text-sm">© This site was designed and developed by @Rayane</p>
	</div>
</footer>
<script>
	function syncFooterMargin() {
		const footer = document.getElementById("site-footer");
		const main = document.getElementById("main-content");
		if (!footer || !main) return;
		(main as HTMLElement).style.marginBottom = footer.offsetHeight + "px";
	}
	syncFooterMargin();
	window.addEventListener("resize", syncFooterMargin);
</script>
