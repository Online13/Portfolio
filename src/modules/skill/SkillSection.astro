---
import { SKILLS_DATA } from "../../data/skills";
import SkillItem from "./SkillItem.astro";
---

<div class="z-10 w-full flex flex-col items-center relative">
  <div class="w-full container relative space-y-4">
    <div class="">
      <p class="max-w-120 text-gray-500">
        Here are few technologies I actively work with to build projects and
        solve problems:
      </p>
    </div>
    <div class="">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2 pt-2">
        {
          SKILLS_DATA.map((skillCategory) => (
            <SkillItem
              key={skillCategory.category}
              category={skillCategory.category}
              skills={skillCategory.skills}
            />
          ))
        }
      </div>
    </div>
  </div>
</div>
