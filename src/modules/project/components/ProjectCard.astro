---
import { ArrowUpRight } from "@lucide/astro";

interface Props {
	slug: string;
	description: string;
	title: string;
	link: string;
	full_description: string;
	technologies: string[];
}

const { slug, title, description, full_description, technologies, link } =
	Astro.props;
---

<div
	id={`project-${slug}`}
	data-slug={slug}
	data-link={link}
	data-title={title}
	data-description={description}
	class="project-item group w-full h-full flex gap-8 flex-col justify-between p-4 bg-white border border-gray-600/30 hover:border-gray-600/60 rounded-md cursor-pointer relative"
>
	<div class="w-full flex items-center justify-between">
		<div class=""></div>
		<div
			class="transform transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 text-neutral-400 group-hover:text-neutral-700"
		>
			<ArrowUpRight />
		</div>
	</div>
	<!-- content -->
	<div class="space-y-2">
		<h3 class="text-md font-semibold text-black">
			{title}
		</h3>
		<p
			class="text-gray-600/70 group-hover:text-gray-600 text-base transition-all duration-300"
		>
			{description}
		</p>
	</div>
	<template class="project-full-desc">
		{full_description}
	</template>
	<ul class="projet-technos" style="display: none;">
		{technologies.map((tech) => <li>{tech}</li>)}
	</ul>
</div>
