---
import { ArrowUpRight } from "@lucide/astro";

interface Props {
  name: string;
  description: string;
}

const { name, description } = Astro.props;
---

<div
  class="group w-full h-full flex gap-8 flex-col justify-between p-4 bg-white border border-gray-600/30 hover:border-gray-600/60 rounded-md cursor-pointer relative"
>
  <div class="w-full flex items-center justify-between">
    <div class=""></div>
    <div
      class="transform transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 text-neutral-400 group-hover:text-neutral-700"
    >
      <ArrowUpRight />
    </div>
  </div>
  <!-- content -->
  <div class="space-y-2">
    <h3 class="text-md font-semibold text-black group-hover:underline">
      {name}
    </h3>
    <p class="text-gray-700 text-base">{description}</p>
  </div>
</div>
