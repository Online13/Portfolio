---
import { ArrowUpRight } from "@lucide/astro";

interface Props {
	title: string;
	description: string;
	date: Date;
	slug: string;
}

const props = Astro.props;
---

<div class="cursor-pointer w-full grid grid-cols-[5fr_1fr] group">
	<div class="flex flex-col gap-1">
		<div class="flex items-center gap-2">
			<h4 class="text-base font-semibold text-black">
				{props.title} 
			</h4>
			<span class="text-sm text-gray-600">
				(in progress)
			</span>
			<ArrowUpRight class="w-4 h-4 opacity-30 transition-all duration-150 group-hover:scale-110 group-hover:opacity-100" />
		</div>
		<p class="text-sm text-gray-600">
			{props.description}
		</p>
	</div>
	<div class="">
		<span class="text-sm text-gray-600">
			{
				props.date.toLocaleDateString("en-US", {
					year: "numeric",
					month: "long",
					day: "numeric",
				})
			}
		</span>
	</div>
</div>
