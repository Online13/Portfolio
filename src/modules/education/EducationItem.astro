---
import Card from "../../components/Card.astro";

interface Props {
  year: string;
  place: string;
  title: string;
}

const { year, place, title } = Astro.props;
---

<Card class="flex flex-col group">
  <h2 class="text-sm text-gray-500">{year}</h2>
  <div class="col-span-2">
    <b class="text-sm">{place}</b>
    <p
      class="text-sm text-stone-500 group-hover:text-primary transition-colors duration-700 whitespace-nowrap"
    >
      {title}
    </p>
  </div>
</Card>
