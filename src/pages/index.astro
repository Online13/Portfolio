---
import "../styles/global.css";
import MainLayout from "../layouts/MainLayout.astro";
import AboutSection from "../modules/about/AboutSection.astro";
import ActiveProjectSection from "../modules/project/ActiveProjectSection.astro";
import PastProjectSection from "../modules/project/PastProjectSection.astro";
import BlogSection from "../modules/blog/BlogSection.astro";
---

<MainLayout title="Rayane">
  <div
    class="w-full flex flex-col items-center [&::-webkit-scrollbar]:w-1.5 [&::-webkit-scrollbar-track]:bg-gray-100 [&::-webkit-scrollbar-thumb]:bg-gray-300"
  >
    <div class="fixed bottom-0 right-0 blur-md opacity-80">
      <svg
        width="499"
        height="363"
        viewBox="0 0 499 363"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
