---
import "../styles/global.css";
import MainLayout from "../layouts/MainLayout.astro";
import ExpSection from "../modules/experience/ExpSection.astro";
import EducationSection from "../modules/education/EducationSection.astro";
import SkillSection from "../modules/skill/SkillSection.astro";
import AboutSection from "../modules/about/AboutSection.astro";
import SectionTitle from "../components/section/SectionTitle.astro";
import SectionContent from "../components/section/SectionContent.astro";
import SectionHeader from "../components/section/SectionHeader.astro";
import VDash from "../components/VDash.astro";
import HDash from "../components/HDash.astro";
import Section from "../components/section/Section.astro";
---

<MainLayout title="Rayane">
  <div
    class="w-full flex flex-col items-center [&::-webkit-scrollbar]:w-1.5 [&::-webkit-scrollbar-track]:bg-gray-100 [&::-webkit-scrollbar-thumb]:bg-gray-300"
  >
    <!-- <HDash class="absolute left-0 top-0 mt-58" /> -->
    <div class="w-full pl-4 relative">
      <div class="flex justify-center">
        <HDash class="w-full absolute top-55" />
        <div class="w-full max-w-160 flex flex-col items-center relative pb-4">
          <VDash class="absolute -left-5 top-0" />
          <div class="w-full h-60"></div>
          <div class="w-full space-y-10 relative">
            <Section>
              <SectionHeader>
                <SectionTitle> About </SectionTitle>
              </SectionHeader>
              <SectionContent>
                <AboutSection />
              </SectionContent>
            </Section>
            <Section>
              <SectionHeader>
                <SectionTitle> Experience </SectionTitle>
              </SectionHeader>
              <SectionContent>
                <ExpSection />
              </SectionContent>
            </Section>
            <Section>
              <SectionHeader>
                <SectionTitle> Education </SectionTitle>
              </SectionHeader>
              <SectionContent>
                <EducationSection />
              </SectionContent>
            </Section>
            <Section>
              <SectionHeader>
                <SectionTitle> Skills </SectionTitle>
              </SectionHeader>
              <SectionContent>
                <SkillSection />
              </SectionContent>
            </Section>
          </div>
        </div>
      </div>
      <HDash />
      <div class="w-full flex justify-center pt-4">
        <div class="w-full max-w-160 pb-24">
          <p class="text-sm">
            © This site was designed and developed by @Rayane
          </p>
        </div>
      </div>
    </div>
  </div>
</MainLayout>
