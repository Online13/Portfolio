---
import "../styles/global.css";
import MainLayout from "../layouts/MainLayout.astro";
import AboutSection from "../modules/about/AboutSection.astro";
import ActiveProjectSection from "../modules/project/ActiveProjectSection.astro";
import PastProjectSection from "../modules/project/PastProjectSection.astro";
import BlogSection from "../modules/blog/BlogSection.astro";
---

<MainLayout title="Rayane">
  <div
    class="w-full flex flex-col items-center [&::-webkit-scrollbar]:w-1.5 [&::-webkit-scrollbar-track]:bg-gray-100 [&::-webkit-scrollbar-thumb]:bg-gray-300"
  >
    <div class="w-full relative">
      <div class="flex justify-center pb-12">
        <div
          class="w-full flex flex-col items-center max-w-160 pt-52 relative pb-4"
        >
          <div class="w-full space-y-16 relative">
            <div class="w-full relative group space-y-1">
              <h1 class="text-2xl font-bold">
                Nekena
                <span class="">Rayane</span>.
              </h1>
              <p class="text-gray-700">
                Software engineer / React Native enthusiast
              </p>
            </div>
            <AboutSection />
            <ActiveProjectSection />
            <PastProjectSection  />
            <BlogSection  />
          </div>
        </div>
      </div>
      <div class="w-full flex justify-center py-8 bg-black text-white">
        <div class="w-full max-w-160">
          <p class="text-sm">
            © This site was designed and developed by @Rayane
          </p>
        </div>
      </div>
    </div>
  </div>
</MainLayout>