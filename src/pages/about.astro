---
import "../styles/global.css";
import Banner from "../components/Banner.astro";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout>
  <Banner>
    <div class="w-full h-full flex justify-center items-center">
      <div class="max-w-170 w-full grid gap-4">
        <h2 class="text-2xl font-medium">About me</h2>
        <p class="max-w-140 text-xl text-gray-700">
          Hi, I'm a software engineer passionate about creating solutions by
          designing interfaces and leveraging mathematics. I enjoy contributing
          to projects that tackle specific problems and turning ideas into
          impactful results.
        </p>
      </div>
    </div>
  </Banner>
</MainLayout>
